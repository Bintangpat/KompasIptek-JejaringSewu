# Database (PostgreSQL 16 with PostGIS)
DATABASE_URL="postgresql://jejaring_user:jejaring_password@localhost:5432/jejaring_sewu?schema=public"

# In-Memory Cache & Distributed Lock (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Security & Token Architecture
JWT_SECRET=super-secret-jwt-key-jejaring-sewu-minimum-256-bits-for-hs256-compliance
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECRET=super-secret-cookie-signing-key-jejaring-pringsewu

# Encryption Keys (AES-256-GCM 32-byte hex & HMAC-SHA256)
NIK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NIK_HMAC_SECRET=hmac-secret-for-nik-hash-jejaring-sewu
TX_TOKEN_SECRET=hmac-secret-for-transaction-token-jejaring-sewu
LEDGER_HMAC_SECRET=hmac-secret-for-ledger-integrity-signature-jejaring-sewu

# Firebase Cloud Messaging (FCM Push & OTP)
FIREBASE_PROJECT_ID=jejaringsewu-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@jejaringsewu-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_PATH=./jejaringsewu-dev-firebase-adminsdk-fbsvc-6a8c0e3fe9.json

# Backblaze B2 (Immutable Object Storage for Selfie PoW)
BACKBLAZE_KEY_ID=
BACKBLAZE_KEY_NAME=jejaringsewu-backend
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=jejaring-sewu-pow-dev
BACKBLAZE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_REGION=us-east-005
BACKBLAZE_DOWNLOAD_URL=https://f005.backblazeb2.com

# Google OAuth2 (Stub for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server & Network Configuration
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
